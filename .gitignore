__pycache__/
*.pyc
.env

# ---- generated run artifacts ------------------------------------------------
# Live (real-model) runs ARE the measurement, and they are committed: a result
# that cannot be checked into the repo cannot be audited or compared. Only
# SELF-TEST runs -- the `mock` backend, stamped `mode=test` -- are excluded: a
# mock scores about 100% by construction, and committing one is how a fake
# result becomes a shipped one. Re-running a mock replaces it; re-running a
# real model costs money, so its record has to be kept.
#
# Layouts: current runs are nested results/<model>/<run_id>/; legacy runs are
# flat files in results/. Mock runs are covered by name on both layouts.
results/mock/
results/run-mock-*
results/mock-*
# Legacy flat artifacts: only mock runs ever existed in the flat layout (live
# runs have always been nested), and those are covered by name above -- these
# rules are the safety net for anything else a stray process drops in the root.
results/*.jsonl
results/*.jsonl.transcript.json
results/*.summary.json
results/*.status.json
results/*.done.json
results/*.html
results/*.log
# Frames are a derived cache -- reproducible from the SVGs, never a result.
results/frames/
results/*/frames/
# Dataset manifests are generated, but the preset ladder is committed so every
# machine and every CI run has exactly the same 200/100/50/20 sets.
results/dataset*.json
!results/dataset-200.json
!results/dataset-100.json
!results/dataset-50.json
!results/dataset-20.json

# Committed on purpose, so the list above does not hide them: the reference
# fixtures the tests assert against. `!` must come after the exclusion.
# mock-opt is the legacy-log fixture: it predates the token split and the
# accounting tests read it to prove a pre-split log is still read correctly.
!results/bench_properties.json
!results/bench_demo.json
!results/bench_demo.txt
!results/killtest.txt
!results/gate_falsification.json
!results/gate_falsification.txt
!results/semantics_check.json
!results/mock-opt.jsonl
!results/mock-opt.summary.json
!results/mock-stale.jsonl
!results/mock-stale.summary.json

.workbuddy-ai
# scratch end-to-end runs
e2e/
.scratch/

# ---- editor / tooling noise ------------------------------------------------
# Dropped into the working directory by editor plugins, not by this project.
thinking-effort-loaded.json

# ---- runtime logs ----------------------------------------------------------
# One logs/<run_id>.log per supervisor job (recreatable; not an input).
logs/
results/*.log
