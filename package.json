{
  "name": "drawtle-bench",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test packages",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "bench": "bun packages/cli/src/index.ts",
    "board": "bun packages/board/src/server.ts",
    "golden": "python3 tools/parity/generate_golden.py --check",
    "golden:regen": "python3 tools/parity/generate_golden.py",
    "ci": "bun run typecheck && bun run lint && bun test packages --timeout 60000 && bun run golden"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.14",
    "typescript": "^5.8.3"
  }
}
